cabal-version: 2.4
name:          sbv-wasm-os
version:       0.1
synopsis:      Out-of-tree System.Process/System.Directory shim for running SBV's
               native solver engine on wasm32-wasi (browser). Keeps SBV pristine.
build-type:    Simple

library
  default-language: Haskell2010
  hs-source-dirs:   src
  exposed-modules:  System.Process
                    System.Directory
  build-depends:    base, ghc-experimental
  ghc-options:      -Wall
