cabal-version: 2.4
name:          grisette-wasm-demo
version:       0.1
synopsis:      Demo: Grisette -> SBV -> in-browser solver, built to wasm32-wasi.
build-type:    Simple

executable grisette-wasm-demo
  default-language: Haskell2010
  hs-source-dirs:   .
  main-is:          Main.hs
  build-depends:    base, grisette, mtl, text
  if !arch(wasm32)
    buildable: False
